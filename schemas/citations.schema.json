{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parsed citations list",
  "type": "object",
  "additionalProperties": false,
  "required": ["citations"],
  "properties": {
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "authors", "title", "year", "venue", "doi", "url", "raw_text"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "authors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["family", "given"],
              "properties": {
                "family": {"type": "string"},
                "given": {"type": "string"}
              }
            }
          },
          "title": {"type": ["string", "null"]},
          "year": {"type": ["integer", "null"]},
          "venue": {"type": ["string", "null"]},
          "doi": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"]},
          "raw_text": {"type": "string"}
        }
      }
    }
  }
}
